# Salin ke .env.local lalu isi nilainya.
# Dipakai oleh scripts/deploy.mjs untuk deploy ke Cloudflare Pages.

# Token API Cloudflare dengan izin "Cloudflare Pages: Edit".
CLOUDFLARE_API_TOKEN=

# ID akun Cloudflare yang memiliki project Pages.
CLOUDFLARE_ACCOUNT_ID=

# Nama project Cloudflare Pages.
CLOUDFLARE_PAGES_PROJECT=webportofolio-diki

# Branch yang dipakai untuk deploy (default: main).
CLOUDFLARE_PAGES_BRANCH=main
